diff --git a/src/styles/variables.css b/src/styles/variables.css
new file mode 100644
index 0000000..ea767fc
--- /dev/null
+++ b/src/styles/variables.css
@@ -0,0 +1,88 @@
+:root {
+  /* ========================================
+     Colors
+     ======================================== */
+
+  --color-background: #0f0717;
+  --color-surface: #1a1025;
+  --color-surface-hover: #241536;
+
+  --color-text: #f5f3f7;
+  --color-text-secondary: #bdb7c9;
+  --color-text-muted: #8c8598;
+
+  --color-accent: #aa3bff;
+  --color-accent-hover: #be68ff;
+
+  --color-border: rgba(255, 255, 255, 0.08);
+
+  /* ========================================
+     Typography
+     ======================================== */
+
+  --font-body:
+    "Inter", "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont,
+    sans-serif;
+
+  --font-display:
+    "Inter", "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont,
+    sans-serif;
+
+  /* ========================================
+     Spacing
+     ======================================== */
+
+  --space-1: 0.25rem;
+  --space-2: 0.5rem;
+  --space-3: 0.75rem;
+  --space-4: 1rem;
+  --space-5: 1.5rem;
+  --space-6: 2rem;
+  --space-7: 3rem;
+  --space-8: 4rem;
+  --space-9: 6rem;
+
+  /* ========================================
+     Border Radius
+     ======================================== */
+
+  --radius-sm: 0.375rem;
+  --radius-md: 0.75rem;
+  --radius-lg: 1rem;
+  --radius-xl: 1.5rem;
+
+  /* ========================================
+     Shadows
+     ======================================== */
+
+  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);
+
+  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.25);
+
+  --shadow-glow: 0 0 32px rgba(170, 59, 255, 0.25);
+
+  /* ========================================
+     Layout
+     ======================================== */
+
+  --content-width: 72rem;
+  --measure: 42rem;
+
+  /* ========================================
+     Layering
+     ======================================== */
+
+  --z-base: 0;
+  --z-header: 100;
+  --z-overlay: 200;
+  --z-modal: 300;
+  --z-tooltip: 400;
+
+  /* ========================================
+     Transitions
+     ======================================== */
+
+  --transition-fast: 150ms ease;
+  --transition-base: 250ms ease;
+  --transition-slow: 400ms ease;
+}
